extends ../layouts/_default.pug

block variables
  - const pageTitle = "Шкода Йети принципиальные электрические схемы";
  - const pageDescription = "Некоторое описание главной страницы";
  - const pageLink = "";

block content
  section.container.section
    h1 #{pageTitle}
    p #{pageDescription}
    h2 читать онлайн, скачать, купить

  section.pdf-viewer
    .pdf-viewer__scribd
      iframe.pdf-viewer__scribd--full(
        src="https://www.scribd.com/embeds/243454667/content?start_page=1&view_mode=scroll&access_key=key-JdZR63lOJqV3wXT0zLuN&show_recommendations=false"
      )

  section.video
    .video__youtube
      iframe.youtube(
        src="https://www.youtube.com/embed/lOjyrLMIooM"
        allowfullscreen
      )
      iframe.youtube(
        src="https://www.youtube.com/embed/ibChlBMtD9o"
        allowfullscreen
      )
